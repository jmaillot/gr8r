# Copy to .env and edit. Docker Compose reads this file automatically.
# .env is git-ignored and excluded from the Docker build context.

# Public hostname Traefik routes to. It must already resolve to this server.
PRJSTUDIO_HOST=projects.example.com

# Absolute URL users see in share links, invite links and the workspace URL
# field, e.g. https://projects.example.com. Leave empty to use the request host,
# which is correct for most single-domain deployments.
# MANDATORY when SMTP_HOST is set: invite emails are built from APP_URL, and
# without it a hostile Host header could email invitation links pointing at
# an attacker's domain. The server refuses to start in that configuration.
APP_URL=

# Created only on the very first start, when the database is empty.
# Use a long, unique password. To change it later, see DEPLOY.md.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_NAME=Your Name

# Shown in the sidebar. Only used when the first workspace is created.
WORKSPACE_NAME=Project1

# URL of the first workspace: https://<PRJSTUDIO_HOST>/w/<WORKSPACE_SLUG>.
# Defaults to the workspace name in lower case ("projects-studio"). Only used when
# the database is first created; an existing workspace keeps its slug.
WORKSPACE_SLUG=

# UID/GID the app runs as. Use `id -u` and `id -g`.
# PGID defaults to PUID when empty. The entrypoint fixes ownership of /data.
PUID=1000
PGID=

# Allow visitors to create their own accounts, and let any signed-in user
# create additional workspaces. When false, accounts come from invitations or
# the CLI, and only an owner or admin of an existing workspace can create one.
ALLOW_SIGNUP=false

# true = demo workspace with sample projects and tasks.
# false = empty workspace. Only used when the database is first created.
SEED_DATA=true

# How long a sign-in lasts.
SESSION_DAYS=30

# How long invite links stay valid.
INVITE_DAYS=7

# ---- Email invitations (optional) ----
# Set SMTP_HOST to email each address-bound invite automatically. Generic
# "Copy invite link" links are still created for you to share yourself.
# Port 587 uses STARTTLS; port 465 uses implicit TLS (SMTP_SECURE is inferred
# from the port when left empty). Use an app password, never your main one.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Sender shown in the email. Required when SMTP_HOST is set; leave empty to
# use SMTP_USER. It usually has to be the SMTP account or an address your
# provider allows you to send from.
MAIL_FROM=
MAIL_FROM_NAME=Projects Studio
MAIL_REPLY_TO=

# EHLO name. Empty uses the container hostname.
SMTP_HELO=
# Keep true in production. false accepts self-signed certificates (testing only).
SMTP_REJECT_UNAUTHORIZED=true
# Require STARTTLS/implicit TLS. false allows a trusted relay without TLS.
SMTP_REQUIRE_TLS=true
# Only for a local test SMTP server without TLS. Never enable with real credentials.
SMTP_ALLOW_INSECURE_AUTH=false
SMTP_TIMEOUT_MS=15000

# auto = mark the session cookie Secure only when the request arrived over HTTPS.
# true / false force the flag on or off.
SECURE_COOKIE=auto

# Trust X-Forwarded-For / -Host / -Proto from the proxy in front of the app.
# The code default is FALSE: with no proxy the server reads NO X-Forwarded-* header,
# so header rotation cannot spoof the per-IP throttles. Set true ONLY behind a proxy
# that overwrites these headers (e.g. Traefik). Without it behind a proxy, the login
# throttle keys on the proxy's address (shared budget) and the Secure cookie flag is
# no longer detected from the request headers.
TRUST_PROXY=false

# Maximum JSON request body size in bytes (default 8 MiB). One whole workspace
# document is saved at a time, so raise this only for a very large workspace.
MAX_BODY_BYTES=8388608

# Per-file upload cap in MEGABYTES for POST /w/:slug/files (default 25).
# Independent of MAX_BODY_BYTES: uploads stream the raw file body, not JSON,
# so this knob — not the JSON body cap — sizes what users may upload.
MAX_UPLOAD_MB=25

# REQUIRED for two-step verification (TOTP). Encrypts 2FA secrets at rest.
# Generate: openssl rand -base64 32
# Losing this value after enrollment makes existing 2FA secrets undecryptable.
MASTER_KEY=
