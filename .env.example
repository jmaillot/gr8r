# Copy to .env and edit. Docker Compose reads this file automatically.
# .env is git-ignored and excluded from the Docker build context.

# Public hostname Traefik routes to. It must already resolve to this server.
GR8R_HOST=gr8r.example.com

# Created only on the very first start, when the database is empty.
# Use a long, unique password. To change it later, see DEPLOY.md.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_NAME=Your Name

# Shown in the sidebar. Only used when the workspace is first created.
WORKSPACE_NAME=Gr8r Studio

# UID/GID the app runs as. Use `id -u` and `id -g`.
# PGID defaults to PUID when empty. The entrypoint fixes ownership of /data.
PUID=1000
PGID=

# Allow visitors to create their own accounts. Off by default.
ALLOW_SIGNUP=false

# true = demo workspace with sample projects and tasks.
# false = empty workspace. Only used when the database is first created.
SEED_DATA=true

# How long a sign-in lasts.
SESSION_DAYS=30

# How long invite links stay valid.
INVITE_DAYS=7

# auto = mark the session cookie Secure only when the request arrived over HTTPS.
SECURE_COOKIE=auto
