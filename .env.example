# Copy to .env and edit. Docker Compose reads this file automatically.
# .env is git-ignored and excluded from the Docker build context.

# Public hostname Traefik routes to. It must already resolve to this server.
PRJSTUDIO_HOST=projects.example.com

# Log verbosity for docker logs: debug | info | warn | error (default: info).
# info shows startup config, migrations, task/assignment/comment events, logins,
# invites and cron pass summaries. debug adds every HTTP request line. warn
# shows only warnings and errors.
LOG_LEVEL=info

# Absolute URL users see in share links, invite links and the workspace URL
# field, e.g. https://projects.example.com. Leave empty to use the request host,
# which is correct for most single-domain deployments.
# MANDATORY when SMTP_HOST is set: invite emails are built from APP_URL, and
# without it a hostile Host header could email invitation links pointing at
# an attacker's domain. The server refuses to start in that configuration.
APP_URL=

# Created only on the very first start, when the database is empty.
# Use a long, unique password. To change it later, see DEPLOY.md.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_NAME=Your Name

# Shown in the sidebar. Only used when the first workspace is created.
WORKSPACE_NAME=Project1

# URL of the first workspace: https://<PRJSTUDIO_HOST>/w/<WORKSPACE_SLUG>.
# Defaults to the workspace name in lower case ("projects-studio"). Only used when
# the database is first created; an existing workspace keeps its slug.
WORKSPACE_SLUG=

# UID/GID the app runs as. Use `id -u` and `id -g`.
# PGID defaults to PUID when empty. The entrypoint fixes ownership of /data.
PUID=1000
PGID=

# Allow visitors to create their own accounts, and let any signed-in user
# create additional workspaces. When false, accounts come from invitations or
# the CLI, and only an owner or admin of an existing workspace can create one.
ALLOW_SIGNUP=false

# Domain admission doors (Phase 75). Each is tri-state:
#   unset            = door off, fail-open (pre-Phase-75 behavior)
#   set but empty    = deny-all for that door
#   comma-separated  = exact allowlist (no subdomain inheritance; case/trailing-dot
#                      insensitive, NFKC-normalized). Malformed entries are
#                      dropped with a boot warning; lists freeze at boot.
# ALLOW_SIGNUP_DOMAINS=*  = allow every domain (explicit wildcard).
# ALLOW_INVITE_DOMAINS unset inherits ALLOW_SIGNUP_DOMAINS.
ALLOW_SIGNUP_DOMAINS=
# ALLOW_INVITE_DOMAINS=

# Workspace creation gate (Phase 78). 'true' | 'false'. Unset = false
# (closed — only Super Admins create workspaces; users get in by invitation).
# 'true' = any signed-in user can create workspaces. Invalid tokens refuse
# to boot. Restart to apply. Independent of ALLOW_SIGNUP.
WORKSPACE_CREATION=
# Super-access gate (owner quick-task, 2026-11-21). 'true' | 'false'.
# Unset = true: the instance admin (Super Admin) can enter any workspace they
# hold no membership in, acting as owner inside it (archived ones read-only).
# 'false' closes that door: the Super Admin keeps instance powers (create/
# archive/delete/rename workspaces, operator console) but cannot browse
# foreign workspaces, and governance loses the Open action. Invalid tokens
# refuse to boot, like WORKSPACE_CREATION. Restart to apply.
SUPER_ACCESS=

# true = demo workspace with sample projects and tasks.
# false = empty workspace. Only used when the database is first created.
SEED_DATA=true

# How long a sign-in lasts.
SESSION_DAYS=30

# How long invite links stay valid.
INVITE_DAYS=7

# ---- Email invitations (optional) ----
# Set SMTP_HOST to email each address-bound invite automatically. Generic
# "Copy invite link" links are still created for you to share yourself.
# Port 587 uses STARTTLS; port 465 uses implicit TLS (SMTP_SECURE is inferred
# from the port when left empty). Use an app password, never your main one.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Sender shown in the email. Required when SMTP_HOST is set; leave empty to
# use SMTP_USER. It usually has to be the SMTP account or an address your
# provider allows you to send from.
MAIL_FROM=
MAIL_FROM_NAME=Projects Studio
MAIL_REPLY_TO=

# EHLO name. Empty uses the container hostname.
SMTP_HELO=
# Keep true in production. false accepts self-signed certificates (testing only).
SMTP_REJECT_UNAUTHORIZED=true
# Require STARTTLS/implicit TLS. false allows a trusted relay without TLS.
SMTP_REQUIRE_TLS=true
# Only for a local test SMTP server without TLS. Never enable with real credentials.
SMTP_ALLOW_INSECURE_AUTH=false
SMTP_TIMEOUT_MS=15000

# auto = mark the session cookie Secure only when the request arrived over HTTPS.
# true / false force the flag on or off.
SECURE_COOKIE=auto

# Trust X-Forwarded-For / -Host / -Proto from the proxy in front of the app.
# The code default is FALSE: with no proxy the server reads NO X-Forwarded-* header,
# so header rotation cannot spoof the per-IP throttles. Set true ONLY behind a proxy
# that overwrites these headers (e.g. Traefik). Without it behind a proxy, the login
# throttle keys on the proxy's address (shared budget) and the Secure cookie flag is
# no longer detected from the request headers.
TRUST_PROXY=false

# Maximum JSON request body size in bytes (default 8 MiB). One whole workspace
# document is saved at a time, so raise this only for a very large workspace.
MAX_BODY_BYTES=8388608

# Per-file upload cap in MEGABYTES for POST /w/:slug/files (default 25).
# Independent of MAX_BODY_BYTES: uploads stream the raw file body, not JSON,
# so this knob — not the JSON body cap — sizes what users may upload.
MAX_UPLOAD_MB=25

# REQUIRED for two-step verification (TOTP). Encrypts 2FA secrets at rest.
# Generate: openssl rand -base64 32
# Losing this value after enrollment makes existing 2FA secrets undecryptable.
MASTER_KEY=

# ---- Database backend (optional) ----
# Leave empty to keep the zero-dependency SQLite default — the app then stores
# everything in DATA_DIR and needs no external database. Set DB_URL to a
# postgres:// URL to use PostgreSQL instead. The database password lives in
# this value: .env is git-ignored, keep it that way.
# Example: DB_URL=postgres://projects:password@db:5432/projects
#
# Initialization is automatic: on an empty database the app creates every
# table at boot, and additive migrations (new columns) apply on every start —
# no manual migration step. To initialize or migrate ahead of the first
# start, run: npm run db:init  (or, in Docker:
# docker compose exec projects node server.js --db-init).
#
# The bundled Postgres container (docker-compose.yml) activates with:
#   docker compose --profile postgres up -d
# and expects DB_URL=postgres://projects:<POSTGRES_PASSWORD>@db:5432/projects
# (set POSTGRES_PASSWORD below when using it).
# Full setup walkthrough in DEPLOY.md, section "Optional: PostgreSQL backend".
DB_URL=

# ---- PostgreSQL container (docker-compose.yml, postgres profile) ----
# Only read when the postgres profile is active. Required in that mode: the
# container refuses to start without it.
POSTGRES_PASSWORD=

# ---- Single sign-on with Microsoft Entra (optional) ----
# SSO turns on only when OIDC_ENABLED=true AND the complete set
# (OIDC_TENANT_ID, OIDC_CLIENT_ID, OIDC_CLIENT_SECRET) is present. A partial
# set is treated exactly like a disabled one. Full setup walkthrough in
# DEPLOY.md, section "Optional: single sign-on with Microsoft Entra".
# Redirect URI to register in the Azure portal:
#   https://<PRJSTUDIO_HOST>/api/auth/oidc/callback
OIDC_ENABLED=false
OIDC_TENANT_ID=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# true = password sign-in is closed; the Microsoft button becomes the only door.
# Fully reversible: clear it and restart, password sign-in resumes.
OIDC_SSO_ONLY=false
# true = a pinned-tenant member's email is trusted without the Azure AD
# `email_verified` claim (work/school tokens omit it). Guests still require
# literal email_verified. Leave false unless SSO logins fail with the generic
# "Sign-in with Microsoft failed" error for real tenant users.
OIDC_TRUST_TENANT_EMAIL=false
# Default "openid profile email"; rarely needs changing.
OIDC_SCOPES=

# Backup archive directory (Phase 87 — optional). Where completed backup task
# archives land; default is DATA_DIR/backups (no config needed). Set it only
# when mounting the archives on a separate volume (docker-compose.yml mounts
# ./data-backups at /backups) — must match the mount target exactly, because
# backup staging lives inside this directory (same-filesystem rename).
BACKUPS_DIR=

# Maximum restore-upload size in MEGABYTES for the restore endpoint
# (default 2048 = 2 GiB). Raise it when archives exceed that.
BACKUP_UPLOAD_MB=2048

# ---- Backup destinations (optional) ----
# Each destination turns on when its env set is COMPLETE; a partial set
# disables it with a boot warning. Values are boot-frozen: restart to apply.
# Credentials never appear in logs, API responses or error text.

# S3-compatible object storage (Phase 88). Works with AWS S3, MinIO, B2, ...
# S3_ENDPOINT: leave empty for AWS (the host is derived from S3_REGION);
# set it for self-hosted/other providers, e.g. http://minio:9000.
# S3_PATH_STYLE: true = virtual-hosted-style OFF (MinIO/B2 and most
# self-hosted endpoints need it); AWS also accepts it. Only 'true'/'false'
# accepted; an invalid value refuses to boot.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_KEY=
S3_PATH_STYLE=true

# FTP / FTPS destination (Phase 98). All of FTP_HOST/FTP_USER/FTP_PASSWORD
# are required together. FTP_SECURE=true uses implicit TLS (usually port 990);
# false = plain FTP (port 21). FTP_PASV_HOST: set it only when the server
# advertises a passive address unreachable from the container (NAT setups) —
# it overrides the IP the PASV replies point at. FTP_INSECURE=true accepts
# self-signed certificates on FTPS (testing only).
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
FTP_SECURE=false
FTP_PASV_HOST=
FTP_INSECURE=false

# SMB destination (Phase 100). All of SMB_HOST/SMB_SHARE/SMB_USER/SMB_PASSWORD
# are required together. SMB_PORT defaults to 445 (direct TCP; NBSS session
# handshake runs only on 139). The client speaks SMB 2.0.2/2.1 with signing
# required; an SMB3-only server is refused with a keyed dialect error.
SMB_HOST=
SMB_PORT=445
SMB_SHARE=
SMB_USER=
SMB_PASSWORD=

# ---- Key rotation (optional) ----
# During a MASTER_KEY rotation, move the old value here (not below) so
# existing 2FA secrets stay decryptable while new ones use MASTER_KEY.
# Both keys must differ; fail-closed if MASTER_KEY is absent.
MASTER_KEY_PREVIOUS=

# ---- Web push notifications (optional) ----
# VAPID keys for browser push. Leave empty: the server generates a keypair on
# first start, stores it in DATA_DIR and reuses it. Pin them here only to keep
# the keys under your own custody — losing them afterwards orphans every
# existing subscription. VAPID_SUBJECT is a contact URI (mailto:) shown to
# push services; empty derives one from APP_URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Name used in backup archive filenames and restore emails to tell
# instances apart (default: container hostname). Letters, digits, dashes.
PROJECTS_STUDIO_INSTANCE_NAME=
