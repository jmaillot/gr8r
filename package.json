{
  "name": "projects-studio",
  "version": "1.1.1",
  "private": true,
  "description": "Projects Studio: a calm, structured project management workspace.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "i18n:scan": "node scripts/i18n-scan.mjs",
    "prebuild": "node scripts/i18n-scan.mjs",
    "prebuild:en": "node scripts/i18n-scan.mjs",
    "build": "vite build",
    "build:en": "LOCALES=en vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "db:init": "node server.js --db-init",
    "seed:json": "node scripts/export-seed.mjs > seed.json",
    "lint": "eslint .",
    "test": "node --test --test-concurrency=2 test/*.test.mjs",
    "test:privacy": "node --test test/privacy.test.mjs",
    "e2e": "playwright test --config e2e/playwright.config.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "lucide": "^1.76.0",
    "prettier": "^3.10.1",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@office-kit/xlsx": "0.27.0",
    "pg": "^8.23.1",
    "web-push": "4.0.0"
  }
}
