{
  "name": "gr8r-studio",
  "version": "1.1.0",
  "private": true,
  "description": "Gr8r Studio: a calm, structured project management workspace.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "seed:json": "node scripts/export-seed.mjs > seed.json",
    "lint": "eslint .",
    "test": "node --test --test-concurrency=2 test/*.test.mjs",
    "test:privacy": "node --test test/privacy.test.mjs",
    "e2e": "playwright test --config e2e/playwright.config.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "lucide": "^0.460.0",
    "prettier": "^3.9.9",
    "vite": "^6.4.4"
  }
}
