{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "projects-studio": {
        "type": "remote",
        "url": "{env:PRJSTUDIO_MCP_URL}",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:PRJSTUDIO_MCP_TOKEN}"
        }
      }
    }
  }
}
